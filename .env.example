# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую
ADMIN_IDS=
# Провайдер-токен платежей Telegram (не используется в целевой версии — можно пусто)
MONEY_TOKEN=

# --- База данных (PostgreSQL) ---
# Можно задать целиком:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/arenda
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=arenda

# --- Почта (отправка документов/уведомлений) ---
# Транспорт (если хостер блокирует SMTP — берите вариант по HTTPS/443):
#   smtp | n8n | gmail | brevo | sendgrid | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM=            # адрес отправителя (для n8n/gmail/API); если пусто — EMAIL_LOGIN

# n8n: бот POST-ит письмо (адресат/тема/текст/PDF-вложения/meta) в вебхук, n8n
# отправляет своей нодой (SMTP-relay/Gmail/email-API). Готовые воркфлоу и инструкция:
#   app/email/n8n_send_email_smtp.workflow.json   (SMTP)
#   app/email/n8n_send_email_brevo.workflow.json  (HTTPS/API, если SMTP заблокирован)
#   docs/n8n_email.md  — подробная пошаговая установка
EMAIL_N8N_URL=        # напр. http://n8n:5678/webhook/send-email

# Gmail API (OAuth2, без телефона/домена, из РФ по 443):
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Внешние email-API (нужен аккаунт провайдера):
EMAIL_API_KEY=

# SMTP (обычно заблокирован у хостеров):
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_LOGIN=
# Для Gmail SMTP — пароль приложения (App Password), не основной пароль
EMAIL_PASSWORD=

# --- Вебхуки n8n ---
# Общий секрет в обе стороны: n8n передаёт его при вызове наших вебхуков, а бот
# при EMAIL_PROVIDER=n8n шлёт его в заголовке X-Webhook-Token при отправке письма.
WEBHOOK_TOKEN=

# --- Приложение ---
TZ=Europe/Moscow

# --- Первичная инициализация (bootstrap) ---
LANDLORD_NAME=Мой бизнес
LANDLORD_INN=

# --- n8n (приём почты и распознавание) ---
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_USER=admin
N8N_PASSWORD=changeme

