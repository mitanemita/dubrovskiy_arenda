# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую
ADMIN_IDS=
# Провайдер-токен платежей Telegram (не используется в целевой версии — можно пусто)
MONEY_TOKEN=

# --- База данных (PostgreSQL) ---
# Можно задать целиком:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/arenda
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=arenda

# --- Почта (SMTP для отправки) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
EMAIL_LOGIN=
# Для Gmail — пароль приложения (App Password), не основной пароль
EMAIL_PASSWORD=

# --- Вебхуки n8n ---
# Общий секрет: n8n должен передавать его в заголовке при вызове наших вебхуков
WEBHOOK_TOKEN=

# --- Приложение ---
TZ=Europe/Moscow
