{
  "name": "Аренда — отправка писем через Unisender Go / UniOne (send-email)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-send-email",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [260, 300],
      "webhookId": "send-email"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://go1.unisender.ru/ru/transactional/api/v1/email/send.json",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            { "name": "X-API-KEY", "value": "={{ $env.UNIONE_API_KEY }}" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ (() => { const b = $json.body || $json; const atts = (b.attachments || []).map(a => ({ type: a.mime_type || 'application/pdf', name: a.filename, content: a.content_base64 })); const message = { recipients: [ { email: b.to } ], subject: b.subject, from_email: b.from, from_name: (b.meta && b.meta.landlord_name) || b.from, body: { plaintext: b.text || '' }, track_links: 0, track_read: 0, skip_unsubscribe: 1 }; if (atts.length) message.attachments = atts; return JSON.stringify({ message }); })() }}",
        "options": {}
      },
      "id": "unione-send",
      "name": "UniOne API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [540, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"ok\": true } }}",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Ответить боту",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [820, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "UniOne API", "type": "main", "index": 0 }]]
    },
    "UniOne API": {
      "main": [[{ "node": "Ответить боту", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {},
  "tags": []
}
